# Copy to ../.env (repository root) or ./.env and fill in your key.
# Environment variables always win over values in a .env file.

# --- Required ---------------------------------------------------------------
# Your OpenAI API key. Used for BOTH embeddings and chat completions.
OPENAI_API_KEY=sk-your-key-here

# --- Models (configuration-driven: change here, no code change needed) ------
# Chat model used to write answers. Any chat model your API key can access works
# here (this is configuration-driven, no code change needed). It is validated at
# startup against GET /v1/models/{model}; if it is not accessible the app logs a
# warning and falls back to gpt-4o-mini so queries keep working.
# Pick a current model from the live catalog: https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for both ingested chunks and questions.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Sampling temperature. Deliberately unset by default: gpt-5.6-* models accept
# only their default temperature and reject an explicit value with HTTP 400.
# Set it only for older models (e.g. gpt-4o-mini) that allow it.
# OPENAI_TEMPERATURE=0.2

# --- Optional tunables (defaults shown) -------------------------------------
# RAG behaviour
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=4
# Drop retrieved chunks below this cosine similarity so weak, off-topic matches
# are not shown as sources. 0.0 disables the filter.
# RETRIEVAL_MIN_SCORE=0.2

# Ingestion limits
# URL_FETCH_TIMEOUT_SECONDS=15
# MAX_CONTENT_CHARS=200000

# OpenAI request timeout (seconds)
# OPENAI_TIMEOUT_SECONDS=30

# Abuse protection: max requests per client IP per minute. The app is
# unauthenticated, so set this on any public deployment to cap OpenAI spend.
# 0 disables it (fine for local single-user use).
# RATE_LIMIT_PER_MINUTE=30

# Ops
# LOG_LEVEL=INFO
# LOG_JSON=true
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
